# ethPandaOps Xatu cluster — used only for execution_state_size (total live state).
# Fill in the password below before running analyses that need state totals.
ETHPANDAOPS_CLICKHOUSE_HOST=clickhouse.xatu.ethpandaops.io
ETHPANDAOPS_CLICKHOUSE_PORT=443
ETHPANDAOPS_CLICKHOUSE_USERNAME=efstateless
ETHPANDAOPS_CLICKHOUSE_PASSWORD=
ETHPANDAOPS_CLICKHOUSE_PROTOCOL=https
